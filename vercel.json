{
  "rewrites": [
    {
      "source": "/signal-desk/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*((LinkedInBot)|(Slackbot)|(Twitterbot)|(facebookexternalhit)|(Facebot)).*"
        }
      ],
      "destination": "/api/signal-desk-entry"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
