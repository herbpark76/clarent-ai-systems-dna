{
  "routes": [
    {
      "src": "/signal-desk/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*((LinkedInBot)|(Slackbot)|(Twitterbot)|(facebookexternalhit)|(Facebot)).*"
        }
      ],
      "dest": "/api/signal-desk-entry"
    },
    {
      "src": "/assets/(.*)",
      "check": true,
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/assets/(.*)",
      "status": 404,
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ]
}
